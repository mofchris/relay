{
  "name": "relay",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "setup": "npm install && node -e \"require('fs').existsSync('.dev.vars')||require('fs').copyFileSync('.dev.vars.example','.dev.vars')\" && npm run db:migrate:local",
    "dev": "concurrently -k -n web,api -c blue,green \"vite\" \"npm run dev:api\"",
    "dev:api": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && wrangler pages dev dist --port 8788 --show-interactive-dev-session=false",
    "build": "tsc -b && vite build",
    "preview": "npm run build && wrangler pages dev dist --port 8788",
    "test": "node --test --disable-warning=ExperimentalWarning \"tests/*.test.ts\"",
    "lint": "eslint .",
    "check": "npm run lint && npm test && npm run build",
    "db:migrate:local": "wrangler d1 migrations apply relay --local",
    "db:migrate:remote": "wrangler d1 migrations apply relay --remote",
    "deploy": "npm run check && wrangler pages deploy dist --project-name relay --branch main"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/martian-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.17.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "wrangler": "^4.158.0"
  },
  "description": "An ad server you can watch think: a real second-price auction on Cloudflare Workers + D1, with a React console that explains every decision.",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  }
}
